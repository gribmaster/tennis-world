# ─────────────────────────────────────────────────────────────────────────────
# Tennis World — root environment template (Phase 0)
# Copy to `.env` and fill in. Values here are SHAPES only, not real secrets.
# Per-app .env.example files live alongside each app (apps/web, apps/api).
# ─────────────────────────────────────────────────────────────────────────────

# Postgres connection used by apps/api (Prisma). Matches docker-compose.yml.
DATABASE_URL="postgresql://tennis:tennis@localhost:5432/tennis_world?schema=public"

# Web data source switch. "mock" uses in-memory data; "api" wires HTTP repositories
# against the public API (see apps/web/.env.example for the web-facing NEXT_PUBLIC_
# variables: NEXT_PUBLIC_DATA_SOURCE and NEXT_PUBLIC_API_BASE_URL).
DATA_SOURCE="mock"
