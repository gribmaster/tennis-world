# apps/web environment. Copy to apps/web/.env.local.
#
# Which repository implementation the web app wires in (see src/domain/index.ts):
#   mock — in-memory data from @tennis/mock-data (default)
#   api  — HTTP repositories against the live API. In `api` mode ALL domains hit the API:
#          the public discovery domains (courts/collections/journal/consultation) AND, as
#          of Feature 57, the PROTECTED saved/user domains (/v1/me/*). Protected reads/
#          writes carry the session: server components forward the incoming cookie; browser
#          islands send it via credentials:'include'. Logged-out visitors are routed to
#          /signin on private pages (Profile/Saved) and prompted to sign in in the
#          Add-to-Collection menu on the (public) court page.
# NEXT_PUBLIC_ prefix so the value is readable in both server and browser bundles.
NEXT_PUBLIC_DATA_SOURCE=api

# Base URL of the public API, INCLUDING the /v1 version segment. Only used when
# NEXT_PUBLIC_DATA_SOURCE=api. Defaults to the local-dev value below when unset.
# NEXT_PUBLIC_ prefix so client islands (e.g. the consultation modal, the auth forms,
# the /verify magic-link landing) can read it.
#
# AUTH REQUIREMENTS for `api` mode (cookie-based session):
#   • The API's API_CORS_ORIGINS must include THIS web origin (e.g. http://localhost:3000)
#     with credentials — a credentialed request can't use a wildcard origin.
#   • The API's WEB_APP_URL must be this web origin: the emailed magic link points at
#     `${WEB_APP_URL}/verify?token=...`, which this app serves (src/app/verify).
#   • AUTH_COOKIE_SECURE must be false on local http (true on https).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:18001/v1
API_BASE_URL=http://127.0.0.1:18001/v1

# ─────────────────────────────────────────────────────────────────────────────
# ⚠️  STAGING-ONLY demo auth (Feature 76). See docs/STAGING_DEMO_AUTH.md.
#
# Lets a client walk through the Vercel STAGING deployment as a fixed, FREE demo user
# WITHOUT magic-link login (the cross-domain session cookie doesn't stick between Vercel
# and Railway). NEVER enable in production. Requires the API to also have demo auth on with
# the SAME secret.
#
# TWO VARS, DELIBERATELY SPLIT so the secret never ships to the browser:
#   • the FLAG is NEXT_PUBLIC_ (public, no secret) — both server and client read it;
#   • the SECRET is NOT NEXT_PUBLIC_ — read ONLY on the server (server components +
#     server actions), so it stays out of the client bundle.
# ─────────────────────────────────────────────────────────────────────────────

# Turn staging demo mode ON in the web app. `true`/`1` = on; unset = off (default). Public
# flag only — carries no secret.
# NEXT_PUBLIC_STAGING_DEMO_AUTH_ENABLED=true

# The demo secret (SAME value as the API's STAGING_DEMO_AUTH_SECRET). NO NEXT_PUBLIC_ prefix —
# it must NOT be inlined into the browser bundle. Read only server-side.
# STAGING_DEMO_AUTH_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Map tiles (Feature 74). The /map explorer, the Saved → Wishlist Map, and the
# Court Detail location preview render a REAL Leaflet map. The tile provider is
# fully env-driven so it can be swapped per-environment with no code change.
# See docs/MAP_PROVIDER_DECISION.md. All NEXT_PUBLIC_ (tile URLs + attribution
# are public; Leaflet fetches tiles client-side). Court markers are plotted from
# the always-public approxLat/approxLng — exact lat/lng never reach the map.
#
# ── Local / dev (default): OpenStreetMap, free, no API key ────────────────────
#   OSM's public tile servers are for light/dev use only — do NOT ship them to
#   production (usage policy + no SLA). Leave these unset to fall back to these
#   exact OSM defaults, or set them explicitly:
NEXT_PUBLIC_MAP_PROVIDER=osm
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors
#
# ── Production (recommended): a proper provider with a custom style + key ──────
#   e.g. MapTiler. Bake YOUR key into the tile URL via env — never commit a real
#   production key. (Do NOT use Google Maps or Mapbox for now — see the doc.)
# NEXT_PUBLIC_MAP_PROVIDER=maptiler
# NEXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/YOUR_STYLE/{z}/{x}/{y}.png?key=YOUR_KEY
# NEXT_PUBLIC_MAP_ATTRIBUTION=© MapTiler © OpenStreetMap contributors