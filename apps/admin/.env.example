# apps/admin environment (TASK_74). Copy to apps/admin/.env.local for local dev.
# Vite only exposes variables prefixed VITE_ to the browser bundle — never put a
# secret here (there is no server-only half of this app; everything in this file
# ships to the browser).

# Base URL of the admin API surface (/v1/admin/*). Local dev: the API on 18001.
VITE_API_BASE_URL=http://127.0.0.1:18001/v1

# Public web app origin, used only to build "View on site" links and to resolve
# root-relative image URLs (local COURT_IMAGE_STORAGE=local writes under
# apps/web/public/uploads/...). Optional — omitting it just means those two
# things show a plain fallback (no broken image, no dead link) instead of a URL.
VITE_WEB_BASE_URL=http://127.0.0.1:18000
