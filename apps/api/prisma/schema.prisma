// ─────────────────────────────────────────────────────────────────────────────
// Tennis World — Prisma schema (FINALIZED for Phase 2, Architecture Plan
// Decision #13). Owned exclusively by apps/api (Decision #3).
//
// The disposable Phase-0 draft (`000_draft_do_not_build_on`) has been dropped and
// the history reset to a single clean `init` migration (Feature 40). The models
// here back the Phase-2 public discovery DTOs in `@tennis/contracts` and are
// seeded from `@tennis/mock-data` by `prisma/seed.ts`.
//
// Entitlement now carries the Phase-5 provider-correlation + lifecycle columns
// (Feature 61, Decision #12: startsAt, providerCustomerId/SubscriptionId/PurchaseId,
// revokedAt, revokedReason, grantedByAdminId) plus the ProcessedWebhookEvent
// idempotency ledger and User.stripeCustomerId — schema/contract groundwork ONLY;
// no runtime reads or writes them yet (the EffectiveEntitlementService + Stripe
// webhook arrive in Features 62/66). Auth/payment/admin/user-collection models are
// otherwise present as FK targets only; no endpoint reads or writes them today.
// No AnalyticsEvent model (Decision #10 — removed from MVP scope).
//
// Coordinate safety (Risk #17): exact `Court.lat`/`lng` are stored but MUST NOT be
// exposed by any public response (no endpoints exist yet). `mapX`/`mapY` are
// decorative screen coords, never geo.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Used by the Prisma CLI for migrations only (migrate dev/deploy/diff, db push).
  // Points at a NON-pooled (session-mode) connection — pgbouncer's transaction
  // pooler (DATABASE_URL, below) does not support the advisory locks / prepared
  // statements Prisma's migration engine needs, which is what caused the prior
  // $transaction timeout (P2028) against Supabase. The generated Prisma Client
  // (runtime queries) never reads this — it always uses `url` above.
  directUrl = env("DIRECT_URL")
}

enum Surface {
  Clay
  Hard
  Grass
}

enum AccessType {
  Resort
  Club
  Academy
  Private
}

enum IndoorOutdoor {
  Indoor
  Outdoor
}

enum CourtStatus {
  draft
  published
}

enum CollectionType {
  editorial
  system
}

enum SkillLevel {
  Beginner
  Intermediate
  Advanced
  Pro
}

enum GroupSize {
  Solo
  Couple
  Family
  Group
}

enum Continent {
  Europe
  Asia
  Americas
  Africa
  Oceania
}

enum EntitlementKind {
  lifetime_unlock
  subscription
  promo_unlock
  manual_grant
}

enum EntitlementStatus {
  active
  revoked
  refunded
  expired
}

enum EntitlementSource {
  stripe_web
  iap_ios
  iap_android
  promo_code
  admin
}

model Country {
  id        String    @id @default(cuid())
  name      String
  isoCode   String    @unique
  continent Continent
  regions   Region[]
  courts    Court[]
}

model Region {
  id        String  @id @default(cuid())
  countryId String
  country   Country @relation(fields: [countryId], references: [id])
  name      String
  lat       Float
  lng       Float
  courts    Court[]
}

model Court {
  id   String @id @default(cuid())
  slug String @unique
  name String

  regionId  String
  region    Region  @relation(fields: [regionId], references: [id])
  countryId String // denormalized for fast world/country zoom queries
  country   Country @relation(fields: [countryId], references: [id])

  // Exact geo — server-only exposure, gated by entitlement check in Phase 4.
  lat       Float
  lng       Float
  // ~10km jittered, always public.
  approxLat Float
  approxLng Float

  // Original Google Maps link supplied for this court (content/<folder>/info.txt
  // "map link:"), preserved verbatim so the entitled-viewer directions link is the
  // SAME link the content author supplied — never a server-derived lat/lng deep
  // link. Server-only exposure (same protected exact-location read as lat/lng);
  // nullable because older/seeded courts predate this field.
  mapLinkUrl String?

  // Decorative [x%, y%] screen position for the stylized map canvas — NOT geo
  // (Risk #17). The serializer recombines these into the `mapCoords` tuple.
  mapX Int
  mapY Int

  surface       Surface
  setting       String
  access        AccessType
  indoorOutdoor IndoorOutdoor
  isScenic      Boolean       @default(false)
  isFeatured    Boolean       @default(false)
  isLocked      Boolean       @default(false)
  status        CourtStatus   @default(draft)
  blurb         String

  // Closed "Experience" tag vocabulary (Feature 72) — see `CourtTag` in
  // packages/contracts/src/enums.ts, which is the single source of truth for the
  // ten allowed values and their canonical order. Stored as a Postgres text[]
  // rather than a normalized tag table: the vocabulary is closed in code, tags
  // carry no per-tag metadata, and the only query is a single array-overlap
  // filter (`GET /v1/courts?tags=`). `@default([])` keeps the column additive and
  // back-safe — existing rows get an empty array with no backfill required.
  // Public, always-visible metadata: NOT location data, unrelated to the
  // entitlement-gated exact-location boundary.
  tags          String[]      @default([])

  // Stable ordinal reproducing the mock-data COURTS array order for deterministic
  // list/map output (so seeded API reads match the mock byte-for-byte).
  seedOrder Int @default(0)

  images          CourtImage[]
  collections     CollectionCourt[]
  savedBy         SavedCourt[]
  userCollections UserCollectionCourt[]
  // Feature 80 — back-relation for the write-only Review model. NO read path uses it:
  // no court select includes it, no DTO derives a rating/average/count from it.
  reviews         Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryId])
  @@index([regionId])
  @@index([status, isFeatured])
}

model CourtImage {
  id        String  @id @default(cuid())
  courtId   String
  court     Court   @relation(fields: [courtId], references: [id])
  url       String
  alt       String?
  sortOrder Int     @default(0)
  isHero    Boolean @default(false)
}

model Collection {
  id            String            @id @default(cuid())
  slug          String            @unique
  name          String
  description   String?
  coverImageUrl String?
  type          CollectionType    @default(editorial)
  sortOrder     Int               @default(0)
  isPublished   Boolean           @default(true)
  courts        CollectionCourt[]
  savedBy       SavedCollection[]
}

model CollectionCourt {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id])
  courtId      String
  court        Court      @relation(fields: [courtId], references: [id])
  sortOrder    Int        @default(0)

  @@id([collectionId, courtId])
}

model Article {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  subtitle        String?
  category        String
  bodyRichText    String
  heroImageUrl    String?
  readTimeMinutes Int
  publishedAt     DateTime?
  // Optional byline (Feature 31 / 44). Mirrors the optional `ArticleDTO.author`
  // and the mock `ARTICLES` byline ('Janet See'). Added as a forward migration
  // (add_article_author) — the Feature-40 schema omitted it, so the seeded API
  // could not reproduce the byline (Feature 43 parity gap). Nullable: a missing
  // byline degrades gracefully, same as `subtitle`/`heroImageUrl`.
  author          String?
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  authProvider String?
  createdAt    DateTime @default(now())
  // Phase-4 groundwork (Feature 51): a profile PATCH (/v1/me) will want a freshness
  // marker. Additive and back-safe — `@updatedAt` is maintained by Prisma on write
  // and is backfilled to `now()` for existing rows by the migration's column default.
  // NOTE: passwordHash is deliberately ABSENT — the ratified auth method is email
  // magic link (Feature 50 §3.3), so the User row stores no secret (the only secret
  // is the single-use MagicLinkToken hash below). Add passwordHash only if/when
  // email+password auth is adopted.
  updatedAt    DateTime @updatedAt

  // Phase-5 groundwork (Feature 61): one Stripe Customer per User, created lazily on
  // first checkout and reused for the customer portal + future purchases. @unique so a
  // webhook can resolve `customer` (cus_…) → User in one indexed read. Lives ONLY on
  // the row — it is NEVER surfaced in any DTO. Nullable: users with no Stripe customer
  // (everyone today) have null.
  stripeCustomerId String? @unique

  // Google OAuth (additive, minimal — Google sign-in feature). Nullable + unique,
  // same pattern as stripeCustomerId above. Populated on first Google sign-in for
  // an account with no prior googleId; NEVER overwritten once set (see
  // GoogleAuthService.findOrCreateUser — reassigning it would silently move an
  // account to a different Google identity). Linking is EMAIL-primary: lookup is
  // always by User.email first, and googleId is only backfilled onto that row.
  googleId  String? @unique
  // Profile picture URL from Google (the only source of this field today — there is
  // no custom-upload UI). Nullable. Refreshed on every successful Google sign-in when
  // Google supplies a picture, so a changed Google photo eventually propagates; never
  // cleared when Google omits one, and never touched by magic-link sign-in.
  avatarUrl String?

  entitlements         Entitlement[]
  savedCourts          SavedCourt[]
  savedCollections     SavedCollection[]
  userCollections      UserCollection[]
  consultationRequests ConsultationRequest[]
  // Feature 80 — back-relation for the write-only Review model (see `Review`). The
  // relation is optional on the Review side (userId String?), so this is the
  // signed-in author's reviews only.
  reviews              Review[]
}

// Phase-5 groundwork (Feature 61, Decision #12). Provider-correlation + lifecycle
// columns added on top of the Phase-0/2 stub. ALL additions are nullable or
// defaulted, so the forward migration is back-safe on a populated table (the table
// is empty today, but CI/prod may hold rows later). NO runtime reads/writes this
// model yet — the EffectiveEntitlementService + Stripe webhook (Features 62/66) do.
//
//   - startsAt               : when access begins. Defaults to now() so existing
//                              semantics (effective at createdAt) are preserved;
//                              supports future-dated grants/trials. Effective-window
//                              math reads startsAt/expiresAt.
//   - providerCustomerId     : Stripe Customer id (cus_…) / IAP app-account token.
//                              Indexed for webhook reconciliation.
//   - providerSubscriptionId : Stripe Subscription id (sub_…) for kind=subscription;
//                              null for one-time/lifetime. Indexed.
//   - providerPurchaseId     : the idempotency anchor — Stripe PaymentIntent (pi_…) /
//                              Checkout Session (cs_…) / IAP transaction id. @unique
//                              so re-delivered fulfillment is a no-op upsert. Nullable
//                              (not every source has a purchase id). Postgres allows
//                              many NULLs under a UNIQUE index, so the @unique only
//                              constrains the populated values — exactly what we want.
//   - revokedAt/revokedReason: set when a refund/chargeback/admin-revoke flips status
//                              away from active (audit trail; the row is never deleted).
//   - grantedByAdminId       : AdminUser.id for kind=manual_grant (Phase-3 admin app
//                              populates it later). Not a DB FK — AdminUser is a soft
//                              ref; nullable, only set for admin grants.
model Entitlement {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  kind      EntitlementKind
  status    EntitlementStatus @default(active)
  source    EntitlementSource
  startsAt  DateTime          @default(now())
  expiresAt DateTime?
  // Provider correlation (Stripe today; IAP/promo/admin later) — never on the wire.
  providerCustomerId     String?
  providerSubscriptionId String?
  providerPurchaseId     String? @unique
  // Revocation / audit (status stays the source of truth; these explain who/why/when).
  revokedAt        DateTime?
  revokedReason    String?
  grantedByAdminId String?
  metadata  Json?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([userId, status])
  @@index([providerCustomerId])
  @@index([providerSubscriptionId])
}

// Phase-5 groundwork (Feature 61) — webhook idempotency ledger. The webhook handler
// (Feature 66) records the provider event id FIRST, inside the same transaction as the
// fulfillment; a re-delivered event hits the PK and is short-circuited as already-
// processed (the canonical Stripe-recommended idempotency pattern). `id` IS the provider
// event id (evt_… for Stripe) — no separate cuid. Also serves the future IAP server-
// notification + CRM webhook handlers (a different `provider`). NO endpoint reads/writes
// this yet.
model ProcessedWebhookEvent {
  id          String   @id // the provider event id (evt_… for Stripe)
  provider    String // "stripe" | "apple" | "google"
  type        String // event type, for triage
  processedAt DateTime @default(now())
}

model SavedCourt {
  userId  String
  user    User     @relation(fields: [userId], references: [id])
  courtId String
  court   Court    @relation(fields: [courtId], references: [id])
  savedAt DateTime @default(now())

  @@id([userId, courtId])
}

// Task 42 — the standalone save/unsave "heart" for an editorial Collection, mirroring
// `SavedCourt` exactly (same composite-PK idempotency shape, same relation pattern).
// Distinct from `UserCollection`/`UserCollectionCourt` (the visitor's OWN wishlist
// folders) — this bookmarks an EDITORIAL `Collection` the user does not own.
model SavedCollection {
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id])
  savedAt      DateTime   @default(now())

  @@id([userId, collectionId])
}

model UserCollection {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  name   String
  // Phase-4 groundwork (Feature 51): the routing key for the per-folder detail view
  // (`/saved/collections/[slug]`); `UserCollectionDTO.slug` is a required contract
  // field. The server derives it on create/rename with the SAME logic the web mock
  // uses (`slugifyCollectionName` + `ensureUniqueSlug`), scoped per user. Uniqueness
  // is PER USER, not global — two users may both have `summer-trip`
  // (`@@unique([userId, slug])` below). `id` remains the mutation key
  // (PATCH/DELETE `/v1/me/collections/:id`); `slug` is only the read/lookup key.
  slug      String
  createdAt DateTime              @default(now())
  courts    UserCollectionCourt[]

  @@unique([userId, slug])
}

model UserCollectionCourt {
  userCollectionId String
  userCollection   UserCollection @relation(fields: [userCollectionId], references: [id])
  courtId          String
  court            Court          @relation(fields: [courtId], references: [id])
  sortOrder        Int            @default(0)

  @@id([userCollectionId, courtId])
}

model ConsultationRequest {
  id                  String      @id @default(cuid())
  userId              String?
  user                User?       @relation(fields: [userId], references: [id])
  name                String?
  email               String
  destinationInterest String
  travelStart         DateTime?
  travelEnd           DateTime?
  isFlexible          Boolean     @default(false)
  skillLevel          SkillLevel?
  groupSize           GroupSize?
  additionalRequest   String?
  source              String?
  status              String      @default("new")
  createdAt           DateTime    @default(now())

  @@index([status, createdAt])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("editor")
  createdAt    DateTime @default(now())
}

// Phase-4 groundwork (Feature 51) — single-use email magic-link tokens (the ratified
// auth method, Feature 50 §3.3/§9). NO behavior is wired in this feature; this model
// only stands the table up so the auth service (Feature 52) can create/consume tokens.
//
// Security shape (Feature 50 §9): only the HASH of the token is stored, never the raw
// token (the raw value lives only in the emailed link); `expiresAt` enforces a short
// TTL; `consumedAt` makes verification single-use (set in the same transaction that
// mints the session). There is intentionally NO relation to `User` — a request-link
// can be issued for an email that has no `User` row yet (the user is upserted on
// verify), so coupling the token to a `User` FK would be wrong. Email normalization
// (lower-casing) is the SERVICE's job at write time, not a schema constraint.
model MagicLinkToken {
  id        String    @id @default(cuid())
  email     String
  // SHA-256 (or similar) hash of the single-use token — unique so a verify lookup is
  // an indexed point read and a collision is impossible. The raw token is never stored.
  tokenHash String    @unique
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime  @default(now())
  // Optional best-effort request context for abuse triage (Feature 50 §9 rate-limiting
  // groundwork). `ipHash` is a hash, never a raw IP. Both nullable — never required.
  userAgent String?
  ipHash    String?

  @@index([email])
  @@index([expiresAt])
}

// Review (Feature 80) — a court review submitted by a signed-in visitor.
//
// COLLECTION ONLY, NO DISPLAY. Nothing in the app reads this table: there is no GET
// endpoint, no aggregate, no average, no count, and no field on any read DTO derives
// from it. The rows are stored for a later, separately-designed surface (which will
// bring its own moderation decisions). The `rating` value IS collected — that is the
// point of collecting — it is simply never rendered.
//
// SHAPE MIRRORS ConsultationRequest (the closest existing write-only model):
//   - `userId` is NULLABLE, exactly as ConsultationRequest.userId is, so anonymous
//     submission stays possible later WITHOUT a migration. That is a schema
//     affordance, not the current policy: `POST /v1/reviews` is guarded by AuthGuard
//     and ReviewsService always writes a real userId. Nothing today can create a row
//     with userId NULL.
//   - `status` is a free-form String defaulting to "new" — the same moderation
//     convention ConsultationRequest.status already uses, so a future admin surface
//     vets both the same way. (The intake sketched "pending"; "new" is what the repo
//     actually does, and the task says to follow ConsultationRequest.)
//
// ONE REVIEW PER USER PER COURT — `@@unique([userId, courtId])`. A person has one
// opinion of a place at a time; letting the same account post unboundedly is a spam
// vector on an endpoint with nothing reading it to notice. The service turns the
// second submission into an UPDATE of that user's existing row (an upsert on this
// constraint), so re-reviewing is "change your review", not "add another".
//
// HOW THAT INTERACTS WITH THE NULLABLE userId: Postgres treats NULLs as distinct in a
// UNIQUE index, so the constraint binds ONLY rows with a real userId — many anonymous
// (userId NULL) rows for the same court remain legal. That is the correct behavior for
// both readings: signed-in submissions are deduplicated per court; a future anonymous
// path is not falsely limited to one row per court globally (which a NULLS-NOT-DISTINCT
// constraint would do). This is the same property Entitlement.providerPurchaseId's
// nullable @unique already relies on.
//
// INDEXES: only the unique constraint above, which the write path itself uses (the
// upsert resolves the row through it) and which Postgres backs with an index anyway.
// It also covers a courtId-leading lookup only via its second column, so it is NOT a
// substitute for a `courtId` index — and that is deliberate: NOTHING reads reviews yet.
// A per-court listing index (`@@index([courtId, status, createdAt])`) and a moderation
// queue index (`@@index([status, createdAt])`) belong to the feature that adds those
// reads, sized against its real query plans. Speculating now would cost write
// throughput for queries that do not exist.
model Review {
  id      String @id @default(cuid())
  courtId String
  court   Court  @relation(fields: [courtId], references: [id])
  // Nullable BY DESIGN (see above) — the write path always sets it today.
  userId  String?
  user    User?  @relation(fields: [userId], references: [id])

  // 1–5 whole stars. Stored, never displayed (no average, no count, no list).
  // The bound is enforced by the contract's zod schema + the request DTO's
  // @IsInt/@Min/@Max, not by a DB CHECK — the same place every other bound in this
  // schema is enforced (there is no CHECK constraint anywhere in this file).
  rating Int
  // The free-text review. Optional, same as ConsultationRequest.additionalRequest:
  // a rating alone is a complete submission.
  body String?

  // Moderation status. "new" until a future admin surface moves it. Same convention
  // and default as ConsultationRequest.status.
  status    String   @default("new")
  createdAt DateTime @default(now())

  @@unique([userId, courtId])
}
