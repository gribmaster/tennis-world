# apps/api environment (Phase 0). Copy to apps/api/.env for Prisma CLI usage.
# Matches docker-compose.yml Postgres service.
#
# TWO DB URLs (Prisma `datasource.url` + `directUrl`):
#   DATABASE_URL — the RUNTIME connection the generated Prisma Client uses for every
#     query the API makes. In production this is the Supabase TRANSACTION pooler
#     (pgbouncer), port 6543 — short-lived pooled connections, right for a
#     request-scoped API. Locally it's just the docker-compose Postgres directly (no
#     pooler distinction on localhost).
#   DIRECT_URL — used ONLY by the Prisma CLI for migrations (migrate dev/deploy/diff,
#     db push) — never read by the running API. In production this is the Supabase
#     SESSION pooler, port 5432 — migrations need the advisory locks / prepared
#     statements the transaction pooler doesn't support (this is what caused the
#     earlier $transaction timeout, Prisma error P2028, against the pooled
#     connection). Locally it can be the SAME docker-compose URL as DATABASE_URL.
DATABASE_URL="postgresql://tennis:tennis@localhost:5432/tennis_world?schema=public"
DIRECT_URL="postgresql://tennis:tennis@localhost:5432/tennis_world?schema=public"

# Port the Nest API listens on (optional; defaults to 3001).
PORT=3001

# ─────────────────────────────────────────────────────────────────────────────
# Auth foundation (Feature 52) — email magic link + stateless JWT.
# SECRETS LIVE HERE ONLY. Never put any of these behind a NEXT_PUBLIC_* prefix
# (they'd ship in the web bundle). The web app needs none of them — it only ever
# sees the httpOnly cookie the API sets.
# ─────────────────────────────────────────────────────────────────────────────

# HMAC signing secret for the access JWT (HS256). MUST be overridden with a long
# random value outside local dev — "change-me" is a deliberately obvious sentinel.
JWT_SECRET=change-me

# Name of the httpOnly session cookie the web client carries.
AUTH_COOKIE_NAME=tennis_session

# Access-token / session-cookie lifetime in SECONDS. No refresh token is modeled
# yet (Feature 50 §3.3 / §7 — deferred), so this is the full session length; keep
# it modest. 3600 = 1h is the dev default; tighten in prod or add refresh.
AUTH_TOKEN_TTL_SECONDS=3600

# Magic-link token lifetime in MINUTES (short — single-use, hashed at rest).
MAGIC_LINK_TTL_MINUTES=15

# Where the emailed magic link points (the web origin that hosts /signin verify).
# The dev mailer builds the link as `${WEB_APP_URL}/verify?token=...`.
WEB_APP_URL=http://localhost:3000

# Comma-separated CORS origin allowlist (credentialed requests need a SPECIFIC
# origin — never `*` with credentials). Empty/missing falls back to the dev
# localhost origins (3000/3001). Do NOT hardcode production origins in code.
API_CORS_ORIGINS=http://localhost:3000

# Set the cookie's `Secure` flag. false for local dev (http); MUST be true in any
# https deployment (staging/prod).
AUTH_COOKIE_SECURE=false

# Session-cookie `SameSite` attribute: lax | none | strict (case-insensitive).
#   - lax    : default. Correct when web + API share a site (same-origin/subdomains).
#   - none   : REQUIRED for cross-site auth where web and API live on different sites
#              (e.g. Vercel web ↔ Railway API). Browsers drop a SameSite=None cookie
#              that isn't also Secure, so this MUST be paired with AUTH_COOKIE_SECURE=true
#              (the API refuses to boot otherwise). Staging/prod cross-site: set `none`.
#   - strict : never sends on cross-site navigation (would break the magic-link landing).
AUTH_COOKIE_SAME_SITE=lax

# Optional cookie Domain (e.g. `.tennisworld.app` to share across subdomains).
# Leave unset for host-only cookies (the right default for localhost).
# AUTH_COOKIE_DOMAIN=

# When true (dev), the mailer logs the magic link/token to the server console
# instead of (not yet) sending real email. Leave true until a real provider is
# wired; false makes request-link a silent no-op send (still returns ok: true).
MAGIC_LINK_DEV_LOG=true

# ─────────────────────────────────────────────────────────────────────────────
# ⚠️  STAGING-ONLY demo auth (Feature 76). See docs/STAGING_DEMO_AUTH.md.
#
# Lets a caller authenticate as a fixed, FREE demo user by sending
# `X-Tennis-Demo-Auth: <secret>` — so a client can walk through the Vercel STAGING
# deployment without magic-link login (the cross-domain session cookie doesn't stick
# between Vercel and Railway). NEVER enable this in production. It is OFF by default
# and is turned on ONLY by the explicit flag below — never by NODE_ENV. It grants NO
# entitlement (the demo user stays free; exact coordinates stay gated) and is not a
# password or general backdoor.
#
# The proper long-term fix is same-parent-domain subdomains so the real session cookie
# works cross-site; this is a temporary staging convenience.
# ─────────────────────────────────────────────────────────────────────────────

# Turn staging demo auth ON. `true`/`1` = on; unset/anything-else = off (the default,
# and the ONLY safe production value). When true, STAGING_DEMO_AUTH_SECRET is REQUIRED —
# the API fails fast at boot without it.
# STAGING_DEMO_AUTH_ENABLED=true

# Long random shared secret the caller must present in `X-Tennis-Demo-Auth`. Server-only,
# NEVER NEXT_PUBLIC_*. Use the SAME value in the web app's (non-public) STAGING_DEMO_AUTH_SECRET.
# Generate with e.g. `openssl rand -hex 32`. Rotating it invalidates any shared header.
# STAGING_DEMO_AUTH_SECRET=

# Email of the demo user (found-or-created; stable name "Demo User"). Optional — defaults
# to demo@tennisworld.local.
# STAGING_DEMO_EMAIL=demo@tennisworld.local

# ─────────────────────────────────────────────────────────────────────────────
# Google OAuth sign-in — additive layer on top of the magic-link auth above. Adds
# GET /v1/auth/google (start) and GET /v1/auth/google/callback. Reuses the SAME
# session cookie the magic-link flow sets (AUTH_COOKIE_* above) — no second
# session system. Requests only `openid email profile` with `access_type=online`
# (no Drive/Calendar/Contacts, no offline access, no refresh token stored).
#
# SECRETS LIVE HERE ONLY. GOOGLE_CLIENT_SECRET is server-only — NEVER behind a
# NEXT_PUBLIC_* prefix (it would ship in the web bundle). The web app never reads
# any Google env; it only navigates the browser to GET /v1/auth/google.
#
# OFF by default (GOOGLE_AUTH_ENABLED unset/false) — the API boots fine with NO
# Google env at all, and both routes respond 404 ("feature off"). Setting
# GOOGLE_AUTH_ENABLED=true without also setting the three values below makes both
# routes respond 503 ("Google sign-in is not configured") instead of crashing the
# process — the rest of the API is unaffected either way (this never fails boot).
# ─────────────────────────────────────────────────────────────────────────────

# Turn Google sign-in ON. `true`/`1` = on; unset/anything-else = off (default).
# GOOGLE_AUTH_ENABLED=true

# OAuth 2.0 Client ID from the Google Cloud Console (console.cloud.google.com →
# APIs & Services → Credentials → OAuth client ID → Web application).
# GOOGLE_CLIENT_ID=

# OAuth 2.0 Client Secret paired with the Client ID above. Server-only, NEVER
# NEXT_PUBLIC_*.
# GOOGLE_CLIENT_SECRET=

# The EXACT redirect URI registered in the Google Cloud Console for this Client
# ID — must be the full callback URL this API serves. Google rejects the token
# exchange if this doesn't byte-for-byte match a registered URI.
#   Local dev:   http://localhost:3001/v1/auth/google/callback
#   Production:  https://api.tennismap.app/v1/auth/google/callback
# GOOGLE_REDIRECT_URI=http://localhost:3001/v1/auth/google/callback

# ─────────────────────────────────────────────────────────────────────────────
# Billing / Stripe (Feature 65) — server-side checkout + customer portal.
# SECRETS LIVE HERE ONLY. NEVER put any of these behind a NEXT_PUBLIC_* prefix —
# they must not ship in the web bundle. The redirect-to-Checkout flow hands the
# browser a HOSTED Stripe URL, so the web app needs NO publishable key and NO
# client Stripe.js. Do NOT commit real keys; use test-mode `sk_test_…` locally.
#
# Leaving STRIPE_SECRET_KEY / STRIPE_PRICE_MONTHLY / STRIPE_WEBHOOK_SECRET unset is
# fine for dev/CI: the API still boots and every non-Stripe harness runs. A
# /v1/billing/* REQUEST then fails cleanly (500 "Billing is not configured"), and the
# webhook returns a safe 500 ("webhook not configured") — never a boot crash.
# ─────────────────────────────────────────────────────────────────────────────

# Stripe secret API key (test mode: sk_test_…). Server-only. Required for real checkout
# AND the webhook (some events retrieve a subscription from Stripe).
# STRIPE_SECRET_KEY=sk_test_your_key_here

# Stripe webhook signing secret (whsec_…) for POST /v1/webhooks/stripe (Feature 66).
# Server-only, NEVER NEXT_PUBLIC_*. Used to verify Stripe-Signature against the RAW
# request body. Get it from `stripe listen` (CLI) or the Dashboard endpoint config.
# When unset the webhook returns a safe 500 ("webhook not configured"); checkout/portal
# are unaffected.
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price id per recurring plan (price_…), each checked independently. A plan whose
# price id is unset returns a clean 400 ("Stripe price is not configured for plan: …")
# from POST /v1/billing/checkout; the other configured plans are unaffected.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_QUARTERLY=
STRIPE_PRICE_YEARLY=

# Where Stripe redirects after a successful / cancelled Checkout. Optional — default
# to ${WEB_APP_URL}/profile?checkout=success and .../profile?checkout=cancelled.
# STRIPE_SUCCESS_URL=http://localhost:3000/profile?checkout=success
# STRIPE_CANCEL_URL=http://localhost:3000/profile?checkout=cancelled

# Where the Customer Portal returns the user. Optional — defaults to ${WEB_APP_URL}/profile.
# STRIPE_PORTAL_RETURN_URL=http://localhost:3000/profile

# ─────────────────────────────────────────────────────────────────────────────
# Billing rate limiting (Feature 69) — lightweight PER-USER limiting for the two
# billing endpoints only (POST /v1/billing/checkout, POST /v1/billing/portal).
#
# The limiter is IN-MEMORY (per API instance) — fine for MVP/dev/single-instance.
# Behind multiple instances a user gets up to N× the limit until a shared store
# (Redis) backs it; see the intake §10 / the Feature-69 note. NO public/discovery/
# auth/webhook route is rate-limited. All three are OPTIONAL — a missing or invalid
# (non-positive/non-numeric) value falls back to the default shown. Values are
# per-user, per-action, within one window.
# ─────────────────────────────────────────────────────────────────────────────

# Rate-limit window length in SECONDS (shared by both actions). Default 600 (10 min).
# BILLING_RATE_LIMIT_WINDOW_SECONDS=600

# Max POST /v1/billing/checkout attempts per user per window. Default 5.
# BILLING_CHECKOUT_RATE_LIMIT_MAX=5

# Max POST /v1/billing/portal attempts per user per window. Default 10.
# BILLING_PORTAL_RATE_LIMIT_MAX=10
